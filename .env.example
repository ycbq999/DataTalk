# Local Docker Compose settings. Keep real credentials out of Git.
DJANGO_SECRET_KEY=django-insecure-local-development-only
DATATALK_DB_OWNER_PASSWORD=local-owner-only
DATATALK_DB_APP_PASSWORD=local-app-only

# Defaults for a new installation. See docs/deployment.md before upgrading an existing one.
DATATALK_DB_NAME=datatalk
DATATALK_DB_OWNER=datatalk_owner
DATATALK_DB_APP=datatalk_app
DATATALK_POSTGRES_VOLUME=datatalk_postgres-data
DATATALK_REDIS_VOLUME=datatalk_redis-data

# Enable the research Compose profile only after filling in both values.
RESEARCH_ENABLED=0
OPENAI_API_KEY=
RESEARCH_DAILY_LIMIT=5
RESEARCH_GLOBAL_DAILY_LIMIT=25
